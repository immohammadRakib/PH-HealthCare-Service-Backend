model Feeder {
  id           String      @id @default(uuid(7))
  name         String      // e.g., "Feeder-05 (Hospital Road)"
  
  substationId String
  substation   Substation  @relation(fields: [substationId], references: [id], onDelete: Cascade) // s বাদ দেওয়া হলো

  areas        Area[]

  isDeleted    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("feeders")
}
