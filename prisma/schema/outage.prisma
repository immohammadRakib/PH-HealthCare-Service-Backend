model Outage {
  id          String       @id @default(uuid(7))
  type        OutageType   @default(SCHEDULED)
  status      OutageStatus @default(PLANNED) // এনামের সাথে ম্যাচ করা হলো
  startTime   DateTime
  endTime     DateTime
  reason      String?      
  
  areaId      String
  area        Area         @relation(fields: [areaId], references: [id], onDelete: Cascade)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([startTime, endTime])
  @@map("outages")
}

model OutageReport {
  id           String       @id @default(uuid(7))
  description  String    
  proofImage   String?  
  status       OutageStatus @default(PENDING) // TicketStatus পরিবর্তন করে OutageStatus করা হলো
  
  customerId   String
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  technicianId String?      
  technician   Technician?  @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("outage_reports")
}
